{
  "manifest_version": 3,
  "name": "Unlined Web",
  "version": "1.1.0",
  "description": "Lets the Web node in Unlined show sites that normally refuse to be framed, such as Gemini. Only affects Unlined tabs.",
  "minimum_chrome_version": "116",
  "permissions": ["declarativeNetRequest", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://unlined.1azy.ink/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["shared.js", "app.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["shared.js", "frame.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
